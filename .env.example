DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Browser-restricted Google Maps JavaScript API key.
# Enable Maps JavaScript API, restrict HTTP referrers, and never use a server credential here.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Optional server-side Copernicus credentials for live satellite catalog/process calls.
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=
